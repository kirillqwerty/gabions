# Server only. Copy to .env; never commit real credentials.
PORT=3000
HOST=127.0.0.1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gabions.by@gmail.com
SMTP_PASS=REPLACE_WITH_GOOGLE_APP_PASSWORD
MAIL_FROM=gabions.by@gmail.com
MAIL_TO=gabions.by@gmail.com
# Exact browser origins, no paths or trailing slashes. Add your preview origin if needed.
ALLOWED_ORIGINS=https://gabions.by,https://www.gabions.by,http://localhost:3000,http://127.0.0.1:3000
# Enable only behind ONE trusted reverse proxy which replaces X-Forwarded-For.
TRUST_PROXY=false
