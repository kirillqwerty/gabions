{
  "name": "gabions-static",
  "version": "1.0.0",
  "private": true,
  "description": "Explicit HTML pages, vanilla CSS and JavaScript. No client-side rendering.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "smtp:verify": "node --env-file-if-exists=.env server/verify.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "nodemailer": "^10.0.3"
  }
}
